# Copy to backend/.env and set the values locally. Do not commit backend/.env.
PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/aesix
MONGODB_DB=aesix
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2:latest

MONGODB_USERNAME="your_db_user"
MONGODB_PASSWORD="your_db_password"

